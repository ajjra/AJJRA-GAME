<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AJJRA GAMES</title>

<style>

*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#0b0b12;
    color:white;
}

header{
    background:#151522;
    padding:18px;
    position:sticky;
    top:0;
    z-index:10;
    border-bottom:1px solid #29293a;
}

.logo{
    font-size:25px;
    font-weight:bold;
}

.logo span{
    color:#00e5ff;
}

.search{
    margin-top:15px;
    width:100%;
    padding:13px;
    border-radius:10px;
    border:none;
    outline:none;
    font-size:16px;
    background:#242435;
    color:white;
}

.categories{
    display:flex;
    gap:8px;
    overflow-x:auto;
    padding:15px 0 5px;
}

.category{
    background:#242435;
    padding:9px 15px;
    border-radius:20px;
    white-space:nowrap;
    cursor:pointer;
}

.category:hover{
    background:#00e5ff;
    color:#000;
}

.container{
    padding:20px;
}

h2{
    margin-top:5px;
}

.games{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(150px,1fr));
    gap:15px;
}

.game{
    background:#171722;
    border-radius:14px;
    overflow:hidden;
    border:1px solid #29293a;
    transition:.2s;
}

.game:hover{
    transform:translateY(-4px);
}

.game img{
    width:100%;
    height:120px;
    object-fit:cover;
    background:#252535;
}

.game-info{
    padding:12px;
}

.game-title{
    font-weight:bold;
    margin-bottom:8px;
}

.play{
    width:100%;
    border:0;
    padding:10px;
    border-radius:8px;
    background:#00e5ff;
    color:#000;
    font-weight:bold;
    cursor:pointer;
}

.play:hover{
    background:#00bcd4;
}

footer{
    text-align:center;
    padding:30px;
    color:#777;
}

</style>
</head>

<body>

<header>

<div class="logo">
🎮 <span>AJJRA</span> GAMES
</div>

<input
class="search"
id="search"
type="text"
placeholder="🔍 Search games..."
>

<div class="categories">

<div class="category" onclick="filterGames('All')">
All
</div>

<div class="category" onclick="filterGames('Arcade')">
Arcade
</div>

<div class="category" onclick="filterGames('Puzzle')">
Puzzle
</div>

<div class="category" onclick="filterGames('Racing')">
Racing
</div>

<div class="category" onclick="filterGames('Sports')">
Sports
</div>

<div class="category" onclick="filterGames('Action')">
Action
</div>

</div>

</header>


<div class="container">

<h2>🔥 Popular Games</h2>

<div class="games" id="games"></div>

</div>


<footer>

© 2026 AJJRA GAMES

</footer>


<script>

const games = [

{
name:"Space Adventure",
category:"Arcade",
image:"https://images.unsplash.com/photo-1614728263952-84ea256f9679",
url:"games/game1.html"
},

{
name:"Puzzle Master",
category:"Puzzle",
image:"https://images.unsplash.com/photo-1606092195730-5d7b9af1efc5",
url:"games/game2.html"
},

{
name:"Speed Racing",
category:"Racing",
image:"https://images.unsplash.com/photo-1503736334956-4c8f8e92946d",
url:"games/game3.html"
},

{
name:"Football Star",
category:"Sports",
image:"https://images.unsplash.com/photo-1579952363873-27f3bade9f55",
url:"games/game4.html"
},

{
name:"Action Hero",
category:"Action",
image:"https://images.unsplash.com/photo-1511512578047-dfb367046420",
url:"games/game5.html"
}

];


function showGames(list){

const container=document.getElementById("games");

container.innerHTML="";

if(list.length===0){

container.innerHTML="<p>No games found.</p>";

return;

}

list.forEach(game=>{

container.innerHTML+=`

<div class="game">

<img
src="${game.image}"
alt="${game.name}"
>

<div class="game-info">

<div class="game-title">
${game.name}
</div>

<div style="color:#888;margin-bottom:10px;">
${game.category}
</div>

<button
class="play"
onclick="openGame('${game.url}')"
>
▶ PLAY
</button>

</div>

</div>

`;

});

}


function openGame(url){

window.location.href=url;

}


function filterGames(category){

if(category==="All"){

showGames(games);

return;

}

const filtered=games.filter(
game=>game.category===category
);

showGames(filtered);

}


document.getElementById("search")
.addEventListener("input",function(){

const text=this.value.toLowerCase();

const filtered=games.filter(game=>
game.name.toLowerCase().includes(text)
);

showGames(filtered);

});


showGames(games);

</script>

</body>
</html>
