<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>AJJRA GAMES</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 background:#070711;
 color:#fff;
 font-family:Arial,sans-serif;
}
header{
 position:sticky;
 top:0;
 z-index:20;
 background:#11111d;
 padding:15px;
 border-bottom:1px solid #29293a;
}
.logo{
 font-size:26px;
 font-weight:bold;
 text-align:center;
}
.logo span{color:#00e5ff}
.search{
 width:100%;
 margin-top:14px;
 padding:13px;
 border:0;
 outline:0;
 border-radius:10px;
 background:#242437;
 color:white;
 font-size:16px;
}
.categories{
 display:flex;
 gap:8px;
 overflow-x:auto;
 margin-top:12px;
}
.cat{
 white-space:nowrap;
 padding:9px 15px;
 border-radius:20px;
 background:#242437;
 cursor:pointer;
}
.cat:hover{
 background:#00e5ff;
 color:#000;
}
.container{padding:18px}
.games{
 display:grid;
 grid-template-columns:repeat(auto-fill,minmax(145px,1fr));
 gap:14px;
}
.card{
 background:#151522;
 border:1px solid #29293a;
 border-radius:14px;
 overflow:hidden;
}
.card img{
 width:100%;
 height:110px;
 object-fit:cover;
}
.info{padding:12px}
.title{
 font-weight:bold;
 margin-bottom:6px;
}
.small{
 color:#888;
 font-size:13px;
 margin-bottom:10px;
}
.play{
 width:100%;
 border:0;
 padding:10px;
 border-radius:8px;
 background:#00e5ff;
 font-weight:bold;
 cursor:pointer;
}
.play:hover{background:#00bcd4}
#gameScreen{
 display:none;
 position:fixed;
 inset:0;
 z-index:100;
 background:#050509;
}
.gameTop{
 height:58px;
 background:#11111d;
 display:flex;
 align-items:center;
 justify-content:space-between;
 padding:10px;
}
.back{
 background:#00e5ff;
 border:0;
 padding:9px 14px;
 border-radius:8px;
 font-weight:bold;
}
#gameCanvas{
 display:block;
 margin:auto;
 background:#050510;
}
.controls{
 position:fixed;
 bottom:15px;
 left:0;
 right:0;
 display:flex;
 justify-content:center;
 gap:15px;
}
.control{
 width:65px;
 height:55px;
 border:0;
 border-radius:12px;
 background:#29293d;
 color:#fff;
 font-size:24px;
}
footer{
 text-align:center;
 color:#777;
 padding:30px;
}
.hidden{display:none}
</style>
</head>

<body>

<header>
<div class="logo">
🎮 <span>AJJRA</span> GAMES
</div>

<input
 id="search"
 class="search"
 placeholder="🔍 Search games..."
>

<div class="categories">
<div class="cat" onclick="filterGames('All')">All</div>
<div class="cat" onclick="filterGames('Arcade')">Arcade</div>
<div class="cat" onclick="filterGames('Puzzle')">Puzzle</div>
<div class="cat" onclick="filterGames('Racing')">Racing</div>
<div class="cat" onclick="filterGames('Sports')">Sports</div>
<div class="cat" onclick="filterGames('Action')">Action</div>
</div>
</header>

<main class="container">

<h2>🔥 AJJRA GAMES</h2>

<div id="games" class="games"></div>

</main>

<footer>
© 2026 AJJRA GAMES
</footer>


<!-- GAME SCREEN -->

<div id="gameScreen">

<div class="gameTop">

<button class="back" onclick="closeGame()">
← BACK
</button>

<b id="gameTitle">GAME</b>

<b id="gameScore">Score: 0</b>

</div>

<canvas id="gameCanvas"></canvas>

<div class="controls">

<button class="control"
ontouchstart="left=true"
ontouchend="left=false"
onmousedown="left=true"
onmouseup="left=false">
◀
</button>

<button class="control"
ontouchstart="shoot()"
onclick="shoot()">
🔥
</button>

<button class="control"
ontouchstart="right=true"
ontouchend="right=false"
onmousedown="right=true"
onmouseup="right=false">
▶
</button>

</div>

</div>


<script>

/* =========================
   GAME DATABASE
========================= */

const games=[

{
 id:1,
 name:"Space Shooter",
 category:"Arcade",
 emoji:"🚀"
},

{
 id:2,
 name:"Puzzle Master",
 category:"Puzzle",
 emoji:"🧩"
},

{
 id:3,
 name:"Speed Racing",
 category:"Racing",
 emoji:"🏎️"
},

{
 id:4,
 name:"Football Star",
 category:"Sports",
 emoji:"⚽"
},

{
 id:5,
 name:"Action Hero",
 category:"Action",
 emoji:"🔥"
}

];


/* =========================
   SHOW GAMES
========================= */

const gameContainer=
document.getElementById("games");

function showGames(list){

 gameContainer.innerHTML="";

 list.forEach(game=>{

  const card=document.createElement("div");

  card.className="card";

  card.innerHTML=`

   <div style="
   height:110px;
   display:flex;
   align-items:center;
   justify-content:center;
   font-size:55px;
   background:#202033;
   ">
   ${game.emoji}
   </div>

   <div class="info">

   <div class="title">
   ${game.name}
   </div>

   <div class="small">
   ${game.category}
   </div>

   <button class="play"
   onclick="openGame(${game.id})">
   ▶ PLAY
   </button>

   </div>
  `;

  gameContainer.appendChild(card);

 });

}

showGames(games);


/* =========================
   SEARCH
========================= */

document
.getElementById("search")
.addEventListener("input",function(){

 const text=this.value.toLowerCase();

 const result=games.filter(game=>
 game.name.toLowerCase().includes(text)
 );

 showGames(result);

});


/* =========================
   CATEGORY
========================= */

function filterGames(category){

 if(category==="All"){
  showGames(games);
  return;
 }

 showGames(
  games.filter(game=>
   game.category===category
  )
 );

}


/* =========================
   GAME ENGINE
========================= */

const screen=
document.getElementById("gameScreen");

const canvas=
document.getElementById("gameCanvas");

const ctx=
canvas.getContext("2d");

let width;
let height;

let currentGame=0;

let score=0;

let left=false;
let right=false;

let bullets=[];
let enemies=[];

let gameRunning=false;

let player={
 x:0,
 y:0,
 size:35,
 speed:6
};


/* =========================
   OPEN GAME
========================= */

function openGame(id){

 currentGame=id;

 screen.style.display="block";

 const game=
 games.find(g=>g.id===id);

 document.getElementById(
 "gameTitle"
 ).innerText=game.name;

 if(id===1){
  startSpaceGame();
 }

 if(id===2){
  startPuzzleGame();
 }

 if(id===3){
  startRacingGame();
 }

 if(id===4){
  startFootballGame();
 }

 if(id===5){
  startActionGame();
 }

}


/* =========================
   CLOSE GAME
========================= */

function closeGame(){

 gameRunning=false;

 screen.style.display="none";

 bullets=[];
 enemies=[];

}


/* =========================
   CANVAS
========================= */

function resizeCanvas(){

 width=Math.min(
 window.innerWidth,
 600
 );

 height=
 window.innerHeight-60;

 canvas.width=width;
 canvas.height=height;

 player.x=width/2;
 player.y=height-80;

}

resizeCanvas();

window.addEventListener(
 "resize",
 resizeCanvas
);


/* =========================
   SPACE SHOOTER
========================= */

function startSpaceGame(){

 score=0;

 bullets=[];
 enemies=[];

 gameRunning=true;

 updateScore();

 resizeCanvas();

 requestAnimationFrame(
 spaceLoop
 );

}

function shoot(){

 if(!gameRunning)return;

 bullets.push({

  x:player.x,

  y:player.y-20,

  speed:9

 });

}

function createEnemy(){

 if(!gameRunning)return;

 enemies.push({

  x:Math.random()*
   (width-40)+20,

  y:-30,

  speed:2+
   Math.random()*2

 });

}

function spaceLoop(){

 if(!gameRunning)return;

 ctx.clearRect(
  0,0,width,height
 );

 if(left)
  player.x-=player.speed;

 if(right)
  player.x+=player.speed;

 if(player.x<20)
  player.x=20;

 if(player.x>width-20)
  player.x=width-20;


 /* bullets */

 bullets.forEach(b=>{
  b.y-=b.speed;
 });

 bullets=
 bullets.filter(b=>b.y>-20);


 /* enemies */

 enemies.forEach(e=>{
  e.y+=e.speed;
 });

 enemies=
 enemies.filter(
  e=>e.y<height+40
 );


 /* collisions */

 for(
  let i=bullets.length-1;
  i>=0;
  i--
 ){

  for(
   let j=enemies.length-1;
   j>=0;
   j--
  ){

   const b=bullets[i];
   const e=enemies[j];

   if(
    Math.abs(b.x-e.x)<25 &&
    Math.abs(b.y-e.y)<25
   ){

    bullets.splice(i,1);
    enemies.splice(j,1);

    score+=10;

    updateScore();

    break;

   }

  }

 }


 /* player collision */

 for(const e of enemies){

  if(
   Math.abs(e.x-player.x)<30 &&
   Math.abs(e.y-player.y)<30
  ){

   gameOver();

   return;

  }

 }


 /* draw player */

 ctx.font="36px Arial";

 ctx.textAlign="center";

 ctx.fillText(
  "🚀",
  player.x,
  player.y
 );


 /* draw bullets */

 ctx.fillStyle="#00e5ff";

 bullets.forEach(b=>{

  ctx.fillRect(
   b.x-2,
   b.y,
   5,
   12
  );

 });


 /* draw enemies */

 ctx.font="30px Arial";

 enemies.forEach(e=>{

  ctx.fillText(
   "👾",
   e.x,
   e.y
  );

 });


 requestAnimationFrame(
  spaceLoop
 );

}


/* =========================
   PUZZLE GAME
========================= */

function startPuzzleGame(){

 gameRunning=false;

 canvas.style.display="none";

 let html=`

 <div style="
 padding:25px;
 text-align:center;
 ">

 <h2>🧩 Puzzle Master</h2>

 <p>Click the correct number!</p>

 <div id="puzzle"
 style="
 display:grid;
 grid-template-columns:
 repeat(3,80px);
 gap:10px;
 justify-content:center;
 ">
 </div>

 </div>
 `;

 screen.insertAdjacentHTML(
  "beforeend",
  html
 );

 createPuzzle();

}

function createPuzzle(){

 const puzzle=
 document.getElementById("puzzle");

 if(!puzzle)return;

 puzzle.innerHTML="";

 let correct=
 Math.floor(Math.random()*9)+1;

 for(let i=1;i<=9;i++){

  const b=
  document.createElement("button");

  b.innerText=i;

  b.style.height="70px";

  b.style.fontSize="25px";

  b.onclick=()=>{

   if(i===correct){

    alert("🎉 Correct!");

    createPuzzle();

   }else{

    alert("❌ Try again!");

   }

  };

  puzzle.appendChild(b);

 }

}


/* =========================
   RACING
========================= */

function startRacingGame(){

 canvas.style.display="block";

 gameRunning=true;

 score=0;

 updateScore();

 resizeCanvas();

 let carX=width/2;

 function racingLoop(){

  if(!gameRunning)return;

  ctx.clearRect(
   0,0,width,height
  );

  if(left)carX-=7;

  if(right)carX+=7;

  if(carX<25)carX=25;

  if(carX>width-25)
   carX=width-25;

  ctx.font="45px Arial";

  ctx.textAlign="center";

  ctx.fillText(
   "🏎️",
   carX,
   height-100
  );

  ctx.font="30px Arial";

  ctx.fillText(
   "🏁",
   width/2,
   100
  );

  score++;

  updateScore();

  requestAnimationFrame(
   racingLoop
  );

 }

 racingLoop();

}


/* =========================
   FOOTBALL
========================= */

function startFootballGame(){

 canvas.style.display="block";

 gameRunning=true;

 score=0;

 updateScore();

 resizeCanvas();

 function footballLoop(){

  if(!gameRunning)return;

  ctx.clearRect(
   0,0,width,height
  );

  ctx.font="80px Arial";

  ctx.textAlign="center";

  ctx.fillText(
   "⚽",
   width/2,
   height/2
  );

  ctx.font="35px Arial";

  ctx.fillText(
   "🥅",
   width/2,
   120
  );

  requestAnimationFrame(
   footballLoop
  );

 }

 footballLoop();

 canvas.onclick=function(){

  score+=10;

  updateScore();

 };

}


/* =========================
   ACTION GAME
========================= */

function startActionGame(){

 canvas.style.display="block";

 gameRunning=true;

 score=0;

 updateScore();

 resizeCanvas();

 let x=width/2;

 function actionLoop(){

  if(!gameRunning)return;

  ctx.clearRect(
   0,0,width,height
  );

  if(left)x-=6;

  if(right)x+=6;

  if(x<30)x=30;

  if(x>width-30)
   x=width-30;

  ctx.font="45px Arial";

  ctx.textAlign="center";

  ctx.fillText(
   "🦸",
   x,
   height-100
  );

  ctx.font="35px Arial";

  ctx.fillText(
   "👹",
   Math.random()*width,
   120
  );

  requestAnimationFrame(
   actionLoop
  );

 }

 actionLoop();

}


/* =========================
   SCORE
========================= */

function updateScore(){

 document.getElementById(
  "gameScore"
 ).innerText=
 "Score: "+score;

}


/* =========================
   GAME OVER
========================= */

function gameOver(){

 gameRunning=false;

 ctx.fillStyle="white";

 ctx.font="30px Arial";

 ctx.textAlign="center";

 ctx.fillText(
  "GAME OVER",
  width/2,
  height/2
 );

 ctx.font="18px Arial";

 ctx.fillText(
  "Score: "+score,
  width/2,
  height/2+40
 );

}


/* =========================
   KEYBOARD
========================= */

document.addEventListener(
 "keydown",
 function(e){

  if(e.key==="ArrowLeft")
   left=true;

  if(e.key==="ArrowRight")
   right=true;

  if(e.code==="Space")
   shoot();

 }
);

document.addEventListener(
 "keyup",
 function(e){

  if(e.key==="ArrowLeft")
   left=false;

  if(e.key==="ArrowRight")
   right=false;

 }
);

</script>

</body>
</html>
